        "import random\n",
        "\n",
        "var = random.randint(0, 20)\n",
        "\n",
        "print(var)\n",
        "\n",
        "if var % 3 == 0:\n",
        "    print(\"Flzz\")\n",
        "elif var % 5 == 0:\n",
        "    print(\"Buzz\")\n",
        "elif var % 3 == 0 and var % 5 == 0:\n",
        "    print(\"FlzzBuzz\")\n",
        "else:\n",
        "    print(var)\n"
      ]
    }
  ]
